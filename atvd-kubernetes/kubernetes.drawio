        <mxCell id="e11" value="tráfego" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="svc" target="pod1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="690"/>
              <mxPoint x="635" y="690"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="acesso externo" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="browser" target="svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="pull da imagem" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="runtime" target="hub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

