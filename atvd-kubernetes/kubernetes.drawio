<mxfile host="app.diagrams.net">
  <diagram id="k8s-arch" name="Arquitetura Kubernetes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Arquitetura do Kubernetes" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-20" width="400" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="Usuário / Dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="kubectl" value="kubectl&lt;br&gt;(CLI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="130" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="cluster" value="Cluster Kubernetes (Minikube)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="30" width="1120" height="800" as="geometry"/>
        </mxCell>

        <mxCell id="cp" value="Control Plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=15;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="1060" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API Server&lt;br&gt;(porta de entrada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="170" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="etcd" value="etcd&lt;br&gt;(estado do cluster)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="105" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sched" value="Scheduler&lt;br&gt;(escolhe o Node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="180" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cm" value="Controller Manager&lt;br&gt;(estado desejado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="255" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cpnote" value="O Control Plane decide e mantém o estado desejado do cluster." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="170" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="node" value="Worker Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf0;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=15;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="1060" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="kubelet" value="Kubelet&lt;br&gt;(agente do Node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="450" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="kproxy" value="Kube-proxy&lt;br&gt;(regras de rede)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="540" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="runtime" value="Container Runtime&lt;br&gt;(Docker / containerd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="630" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="rs" value="ReplicaSet (mantém o número de réplicas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d79b00;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="440" width="420" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="pod1" value="Pod 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="500" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="Container&lt;br&gt;usuario/my_app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="565" y="535" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pod2" value="Pod 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="500" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="Container&lt;br&gt;usuario/my_app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="755" y="535" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="labels" value="Label dos Pods: app=my_app" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="650" width="360" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="svc" value="Service&lt;br&gt;(NodePort)&lt;br&gt;selector: app=my_app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="520" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="browser" value="Navegador&lt;br&gt;(minikube service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="530" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hub" value="Docker Hub&lt;br&gt;(imagem usuario/my_app)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="880" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="user" target="kubectl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="comandos (HTTPS)" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="kubectl" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="lê / grava estado" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="api" target="etcd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="novos Pods" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="api" target="sched">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="monitora" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="api" target="cm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="instruções / status" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="api" target="kubelet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="cria containers" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="kubelet" target="runtime">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="480"/>
              <mxPoint x="480" y="660"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="gerencia" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="kubelet" target="pod1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="configura rede" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="kproxy" target="svc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="365" y="710"/>
              <mxPoint x="1150" y="710"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="tráfego" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="svc" target="pod2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="570"/>
              <mxPoint x="1020" y="555"/>
            </Array>
          </mxGeometry>
